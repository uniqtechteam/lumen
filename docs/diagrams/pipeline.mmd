flowchart LR
    S[schema.prisma] --> P[lumen-schema<br/>parse, check, format]
    P --> C[lumen-migrate<br/>calculate]
    DB[(Postgres)] --> D[describe]
    C --> F{diff}
    D --> F
    F --> K[check<br/>counts rows first]
